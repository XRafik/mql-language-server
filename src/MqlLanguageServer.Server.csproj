<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MqlLanguageServer</RootNamespace>
    <AssemblyName>mql-lsp-server</AssemblyName>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Run without system ICU (libicu). The server does not need culture-
         specific globalization: parsing is ASCII-based and the LSP transport
         is UTF-8. Without this flag the self-contained single-file binaries
         FailFast at startup on hosts without libicu (#65). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Enable argument passing for single-file apps -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- NuGet Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mql-lsp-server</ToolCommandName>
    <PackageId>mql-language-server</PackageId>
    <Version>2.6.2</Version>
    <Authors>Guillermo Davalillo</Authors>
    <Description>Language Server Protocol implementation for MQL4 and MQL5 (MetaTrader 4/5)</Description>
    <!-- NuGet package authoring best practices:
         https://learn.microsoft.com/nuget/create-packages/package-authoring-best-practices -->
    <Copyright>Copyright (c) Guillermo Davalillo 2026</Copyright>
    <PackageProjectUrl>https://github.com/davalillo/mql-language-server</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/davalillo/mql-language-server/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>lsp;mql4;mql5;metatrader;metaeditor;mqh;mt4;mt5;expert-advisor;language-server</PackageTags>
    <RepositoryUrl>https://github.com/davalillo/mql-language-server</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Embeds the build date (UTC, format yyyyMMdd_HHmmss) as assembly metadata.
       The SDK emits these attributes when generating AssemblyInfo during compile,
       so the value reflects the moment the current assembly was last compiled.
       Incremental builds that skip CoreCompile keep the previous stamp. -->
  <ItemGroup Condition="'$(DesignTimeBuild)' != 'true'">
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyyMMdd_HHmmss'))" />
  </ItemGroup>

  <!-- Override settings when packing as NuGet Tool -->
  <Target Name="PackTool" AfterTargets="Build">
    <PropertyGroup>
      <SelfContained>false</SelfContained>
      <PublishSingleFile>false</PublishSingleFile>
    </PropertyGroup>
  </Target>

  <!-- Files packed into the NuGet package root (readme + icon).
         Both live at the repository root; the csproj lives in src/. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\packaging\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MqlLanguageServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="OmniSharp.Extensions.LanguageProtocol" Version="0.19.9" />
    <PackageReference Include="OmniSharp.Extensions.JsonRpc" Version="0.19.9" />
    <PackageReference Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />
    <PackageReference Include="OmniSharp.Extensions.LanguageServer.Shared" Version="0.19.9" />
    <!-- Newtonsoft.Json arrives transitively via OmniSharp.Extensions 0.19.9 (resolved 13.0.3).
         Pinning it explicitly guards against a future OmniSharp downgrade silently restoring
         a version below 13.0.1, which is affected by CVE-2024-21907 / GHSA-5crp-9r3c-p9vr
         (DoS via deep JSON nesting). The exact resolved version (13.0.3) is pinned rather
         than a floor (>= 13.0.1) so restore stays deterministic; bump it deliberately. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- MediatR arrives transitively via OmniSharp.Extensions 0.19.9. It is pinned to the
         [8.1.0, 9.0.0) range (NuGet interval notation: floor 8.1.0 inclusive, ceiling
         9.0.0 exclusive) for two reasons: (1) it keeps the 8.x API surface OmniSharp 0.19.9
         was tested against, and (2) it acts as a license guard — MediatR versions up to
         12.x are Apache-2.0, but the 13.0.0+ line (July 2025) is distributed under a
         commercial / RPL-1.5 dual license by Lucky Penny Software, so the range blocks
         the commercial line and any API change past the ceiling makes the upgrade an
         explicit, reviewed change rather than a silent transitive resolution. -->
    <PackageReference Include="MediatR" Version="[8.1.0, 9.0.0)" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Antlr4BuildTasks" Version="12.14.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #136: documentation-driven golden lists, embedded as the
         single source of truth for Mql4Builtins / Mql5Builtins and the
         Mql4OnlyApiRegistry (5060) projection. -->
    <EmbeddedResource Include="..\data\builtins\mql4.json" LogicalName="MqlLanguageServer.Builtins.builtins.mql4.json" />
    <EmbeddedResource Include="..\data\builtins\mql5.json" LogicalName="MqlLanguageServer.Builtins.builtins.mql5.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Ship third-party license notices inside the NuGet tool package
         (BSD-3-Clause notice preservation for the ANTLR runtime). -->
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- ANTLR Grammar Generation -->
  <ItemGroup>
    <Antlr4 Include="Mql4/Grammar/Mql4Grammar.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>true</Listener>
      <Visitor>true</Visitor>
      <Package>Mql4Grammar</Package>
      <AntOutDir>$(MSBuildProjectDirectory)/Parser/Generated/Mql4</AntOutDir>
    </Antlr4>
    <Antlr4 Include="Mql5/Grammar/Mql5Grammar.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>true</Listener>
      <Visitor>true</Visitor>
      <Package>Mql5Grammar</Package>
      <AntOutDir>$(MSBuildProjectDirectory)/Parser/Generated/Mql5</AntOutDir>
    </Antlr4>
  </ItemGroup>

</Project>
